# n8n_showcase — environment configuration
# Copy to .env and fill in, or keep values in ~/.claude/.env (helper scripts
# load it via scripts/lib/env.js; process.env wins on conflict).

# n8n public API access. Used by every script that talks to the instance:
# export-live-workflows, generate-registry, drift, install-workflow,
# list-workflows, secure-n8n-webhooks.
N8N_URL=
N8N_API_KEY=

# Shared secret sent as the X-Webhook-Secret header by n8n webhook callers.
# Must match the Header Auth credential bound to the webhook nodes.
# See docs/WEBHOOK_AUTH.md.
N8N_WEBHOOK_SECRET=

# Existing n8n credential id to reuse for X-Webhook-Secret bindings
# (consumed by scripts/secure-n8n-webhooks.js and secure-internal-callers.js).
N8N_WEBHOOK_AUTH_CRED_ID=
