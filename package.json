{
  "name": "n8n-showcase",
  "version": "3.0.0",
  "description": "A production voice-AI operation on n8n: sanitized exhibits of the live workflows behind Sarah — outbound calling, post-call extraction, self-healing, eval, CI/CD — plus the toolchain that keeps them honest",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "bats tests",
    "verify": "node scripts/verify-workflows.js",
    "governance": "node scripts/governance-engine.js",
    "lint": "node bin/n8n-lint.js workflows",
    "lint:ratchet": "node bin/n8n-lint.js workflows --baseline lint-baseline.json",
    "check:code-nodes": "node scripts/check-code-nodes.js",
    "drift": "node bin/drift.js",
    "export": "node scripts/export-live-workflows.js",
    "registry": "node scripts/generate-registry.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wranngle/n8n_showcase.git"
  },
  "bin": {
    "n8n-showcase-drift": "bin/drift.js",
    "n8n-showcase-lint": "bin/n8n-lint.js"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "wranngle",
  "license": "MIT"
}
